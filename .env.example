# Copy this file to `.env.local` and fill in the values from
# Supabase → Project Settings → API.
#
# Only PUBLIC values belong here: everything prefixed with VITE_ is bundled
# into the browser. NEVER put the service_role / secret key in this file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon public" key (or the newer "publishable" key, sb_publishable_...)
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
